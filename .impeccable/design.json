  "narrative": {
    "northStar": "The Pinned Board",
    "overview": "One person's working surface: things placed where they can be picked up. On a wide screen the surface is blue paper and the contents are a fanned deck of cards that pull out toward you. Below 900px the same page runs in one column with a centred hero and the deck is not shown. The two share everything: paper, type, one accent, both themes.",
    "keyCharacteristics": [
      "One composition logic, two forms: a fan from 900px up; below it the hero is itself a small stack of cards you can bring forward.",
      "The phone is the desktop page narrowed, not a second look: same fonts, colours, buttons and panel.",
      "Tokens-only theming: blue paper by day, a night board by night.",
      "Motion is spring-like and rare: the card pull-out on desktop, nothing animates on mobile.",
      "The desktop fan follows the pointer by a few pixels, more for the cards on top; nothing else moves on its own."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "Signal Blue is the only accent for surfaces, fills and text. A warm amber and the Spotify green exist only for small marks, glyphs and washes on mobile; they never fill a button or carry text.",
        "section": "colors"
      },
      {
        "name": "The Quiet Ground Rule",
        "body": "The ground stays paper or night in both themes; colour lives on the objects.",
        "section": "colors"
      },
      {
        "name": "The Two Tiers Rule",
        "body": "The name is the one large thing; the role sits a full step below it.",
        "section": "typography"
      },
      {
        "name": "The Resting Weight Rule",
        "body": "Hover marks an object by brightening it, sharpening its shadow and sliding it a few pixels along its stack; it never raises it above its neighbours. Only the click pulls a card out.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep colour on the objects and the ground quiet in both themes.",
      "Do build mobile from the desktop's own tokens; a phone layout is the same page narrowed.",
      "Do use the display face for the name and titles only and Inter for everything read.",
      "Do keep every interactive object a real button or link with a visible `:focus-visible` outline.",
      "Do self-host fonts; no third-party font requests."
    ],
    "donts": [
      "Don't add a second accent next to Signal Blue.",
      "Don't raise a desktop card above its neighbours on hover; brightening and a small slide mark it, only the click pulls it out. (Mobile cards behind slide 6px further out on hover.)",
      "Don't use hard offset shadows or glows for depth.",
      "Don't colour the cards of the mobile stack; they stay white (a touch dimmer behind), with Signal Blue only on the icon tile."
    ]
  }
}